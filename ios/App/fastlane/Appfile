# Do not change app_identifier — TestFlight/App Store Connect identify
# the app by it, same as capacitor.config.ts's appId.
app_identifier("app.lovable.8119531570f64ad1b5f9255d17b94d5e")

# If the App Store Connect account this key belongs to has access to more
# than one team, fastlane may need to be told which one explicitly. Set an
# ASC_TEAM_ID GitHub secret (find it under Apple Developer → Membership)
# and it will be picked up automatically here.
team_id(ENV["ASC_TEAM_ID"]) if ENV["ASC_TEAM_ID"]
itc_team_id(ENV["ASC_TEAM_ID"]) if ENV["ASC_TEAM_ID"]
