default_platform(:ios)

platform :ios do
  desc "Build the app and upload a new build to TestFlight"
  lane :beta do
    team_id = ENV["ASC_TEAM_ID"]
    UI.user_error!(
      "ASC_TEAM_ID is not set. Automatic signing needs an Apple Developer " \
      "Team ID — find it at developer.apple.com/account under Membership " \
      "details, add it as the ASC_TEAM_ID GitHub secret, then re-run."
    ) if team_id.to_s.empty?

    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_P8"],
      is_key_content_base64: false
    )

    # Build number: always one higher than whatever TestFlight already
    # has, so it never needs to be tracked by hand. Falls back to 1 only
    # if TestFlight has no builds yet at all (shouldn't happen here —
    # the app already has builds from before this pipeline existed).
    latest_build_number =
      begin
        latest_testflight_build_number(api_key: api_key)
      rescue => e
        UI.important("Could not read the latest TestFlight build number (#{e.message}); starting from 1.")
        0
      end

    increment_build_number(
      build_number: latest_build_number + 1,
      xcodeproj: "App.xcodeproj"
    )

    # This project uses Swift Package Manager (Capacitor 7+ default), not
    # CocoaPods — there's no .xcworkspace, just the plain .xcodeproj.
    #
    # Signing is automatic via the App Store Connect API key — no
    # exported certificates/provisioning profiles stored anywhere. The
    # key needs the Admin role in App Store Connect for this to be
    # allowed to create/manage certificates and profiles on its own.
    # DEVELOPMENT_TEAM has to be passed explicitly: the generated Xcode
    # project doesn't have one set, and automatic signing can't pick a
    # team on its own even with -allowProvisioningUpdates.
    #
    # Passing api_key: here (not just to the other actions above) is
    # what makes gym hand the key to xcodebuild itself
    # (-authenticationKeyPath/-authenticationKeyID/-authenticationKeyIssuerID)
    # so -allowProvisioningUpdates has something to authenticate with.
    # Without it, xcodebuild has no account at all, hence "No Accounts"
    # and "No profiles found".
    build_app(
      scheme: "App",
      project: "App.xcodeproj",
      export_method: "app-store",
      export_options: {
        signingStyle: "automatic",
        teamID: team_id
      },
      xcargs: "-allowProvisioningUpdates DEVELOPMENT_TEAM=#{team_id}",
      api_key: api_key
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
